@ORCHESTRATION_CLUSTER_MANAGEMENT_API = http://localhost:9600
@fixedTimestamp=123
###

POST {{ORCHESTRATION_CLUSTER_MANAGEMENT_API}}/actuator/exporting/pause?soft=true
Content-Type: application/json

###


POST {{ORCHESTRATION_CLUSTER_MANAGEMENT_API}}/actuator/backupRuntime
